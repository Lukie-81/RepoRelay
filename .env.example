# RepoRelay local-first MCP bridge configuration template.
HOST=127.0.0.1
PORT=7676

# Replace this placeholder with one absolute, canonical repository directory.
# Windows example: C:\path\to\approved-repository
REPORELAY_ALLOWED_ROOTS=<absolute-path-to-approved-repository>

# RepoRelay always runs the authenticated constrained review surface. It
# exposes four read/search tools and, only when enabled below, three fixed
# .ai-handoff writers.
REPORELAY_HANDOFF_WRITES=0

# Required when an authenticated tunnel forwards ChatGPT Web traffic. Generate
# at least 32 random characters and load the real value from protected local
# secret storage. Never commit it to this file.
REPORELAY_BRIDGE_AUTH=1
REPORELAY_BRIDGE_SECRET=<generate-a-long-random-bridge-secret>

# Set this to the HTTPS tunnel origin, without /mcp, when applicable.
REPORELAY_PUBLIC_BASE_URL=https://your-tunnel-host.example.com
REPORELAY_ALLOWED_HOSTS=127.0.0.1,your-tunnel-host.example.com

REPORELAY_LOG_LEVEL=info
REPORELAY_LOG_FORMAT=json
REPORELAY_LOG_REQUESTS=1
REPORELAY_LOG_TOOL_CALLS=1
