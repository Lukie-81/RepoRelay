# RepoRelay local-first MCP bridge configuration template.
HOST=127.0.0.1
PORT=7676

# Replace this placeholder with one absolute, canonical repository directory.
# Windows example: C:\path\to\approved-repository
DEVSPACE_ALLOWED_ROOTS=<absolute-path-to-approved-repository>

# The public-safe profile. It exposes four read/search tools and, only when
# enabled below, three fixed .ai-handoff writers.
DEVSPACE_TOOL_MODE=chatgpt-review
DEVSPACE_HANDOFF_WRITES=0

# Required when an authenticated tunnel forwards ChatGPT Web traffic. Generate
# at least 32 random characters and load the real value from protected local
# secret storage. Never commit it to this file.
DEVSPACE_CHATGPT_BRIDGE_AUTH=1
DEVSPACE_CHATGPT_BRIDGE_SECRET=<generate-a-long-random-bridge-secret>

# Set this to the HTTPS tunnel origin, without /mcp, when applicable.
DEVSPACE_PUBLIC_BASE_URL=https://your-tunnel-host.example.com
DEVSPACE_ALLOWED_HOSTS=127.0.0.1,your-tunnel-host.example.com

# Review mode disables widgets, artifacts, skills, subagents, shell/process
# tools, generic writes, patches, deletes, and worktrees regardless of these
# broader project defaults.
DEVSPACE_WIDGETS=off
DEVSPACE_ARTIFACTS=0
DEVSPACE_SKILLS=0
DEVSPACE_SUBAGENTS=0

DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
